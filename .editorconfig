root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{html,css,scss,less}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,woff,woff2,ttf,eot}]
insert_final_newline = false
trim_trailing_whitespace = false
