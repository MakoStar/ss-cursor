{
  "name": "@makostar/ss-cursor",
  "version": "1.0.3",
  "description": "stella cursor touch effect",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.umd.js",
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.esm.js": "./dist/index.esm.js",
    "./dist/index.esm.min.js": "./dist/index.esm.min.js",
    "./dist/index.cjs.js": "./dist/index.cjs.js",
    "./dist/index.cjs.min.js": "./dist/index.cjs.min.js",
    "./dist/index.umd.js": "./dist/index.umd.js",
    "./dist/index.umd.min.js": "./dist/index.umd.min.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/clean-dist-maps.ts && rollup -c && npm run copy-assets",
    "copy-assets": "tsx scripts/copy-assets.ts",
    "dev": "rollup -c && npm run copy-assets && rollup -c -w",
    "serve": "npx serve . -l 3000",
    "start": "npm run build && npm run serve",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ss-cursor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^26.5.1",
    "rollup": "^4.28.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "sideEffects": false
}